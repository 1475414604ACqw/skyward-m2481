+
+/// The handle of the binder a reply carries, found by its type word wherever
+/// the reply puts it: a directory built as a newer Android wraps the service
+/// it names in metadata this build does not know the shape of, and the binder
+/// itself is what the caller needs.
+fn flat_handle(bytes: &[u8]) -> Option<u32> {
+    // A flat_binder_object: its type, its flags, the handle, then the cookie.
+    const HANDLE: [u8; 4] = u32::from_be_bytes(*b"sh*\x85").to_le_bytes();
+    bytes.windows(4).enumerate().find_map(|(at, word)| {
+        (word == HANDLE && at + 12 <= bytes.len()).then(|| u32::from_le_bytes(bytes[at + 8..at + 12].try_into().unwrap()))
+    })
 }
 
