+/// Mount the data partition as it stands, for a phone whose data holds no
+/// encryption: a partition a recovery formatted afresh is a plain f2fs or
+/// ext4, and it mounts with no key out of the secure world. Nothing is
+/// opened of the users' own files, which such a partition has none of.
+pub fn open_unencrypted() -> Result<Option<Opening>> {
+    if mount::is_mount_point(Path::new(MOUNT))? {
+        return Ok(Some(Opening { mounted: None, closed: Vec::new() }));
+    }
+    let device = Path::new("/dev/block/bootdevice/by-name/userdata");
+    let Some(filesystem) = skyward_block::probe::filesystem(device)? else {
+        return Ok(None);
+    };
+    if mount::mount(device, Path::new(MOUNT), &filesystem, &["rw".to_string()]).is_err() {
+        return Ok(None);
+    }
+    // The folder the phone shows its users' shared files from, which a
+    // partition a recovery made has none of yet.
+    let media = Path::new("/data/media/0");
+    let _ = std::fs::create_dir_all(media);
+    let sdcard = Path::new(SDCARD);
+    if !mount::is_mount_point(sdcard).unwrap_or(false) {
+        let _ = mount::bind(media, sdcard);
+    }
+    Ok(Some(Opening {
+        mounted: Some(Opened { mapped: device.to_path_buf(), filesystem, checked: None }),
+        closed: Vec::new(),
+    }))
+}
