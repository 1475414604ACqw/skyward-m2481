+
+/// Put every file under `root` into the ramdisk at the path it has under
+/// `root`, a file that is already there replaced. The mode keeps whether
+/// the file is one a user may run, as a recovery's own copies of the phone's
+/// programs do.
+fn add_tree(rd: &mut Ramdisk, root: &Path) -> Result<usize> {
+    fn walk(dir: &Path, out: &mut Vec<PathBuf>) -> Result<()> {
+        for entry in std::fs::read_dir(dir).with_context(|| format!("read {}", dir.display()))? {
+            let path = entry?.path();
+            if path.is_dir() {
+                walk(&path, out)?;
+            } else if path.is_file() {
+                out.push(path);
+            }
+        }
+        Ok(())
+    }
+    let mut files = Vec::new();
+    walk(root, &mut files)?;
+    files.sort();
+    let mut added = 0;
+    for file in files {
+        let rel = file.strip_prefix(root).with_context(|| format!("{} is not under {}", file.display(), root.display()))?;
+        let name = rel.to_string_lossy().replace('\\', "/");
+        #[cfg(unix)]
+        let runnable = {
+            use std::os::unix::fs::PermissionsExt;
+            std::fs::metadata(&file)?.permissions().mode() & 0o111 != 0
+        };
+        #[cfg(not(unix))]
+        let runnable = false;
+        let mode = if runnable { 0o755 } else { 0o644 };
+        let data = std::fs::read(&file).with_context(|| format!("read {}", file.display()))?;
+        if rd.find(&name).is_some() {
+            rd.replace(&name, data)?;
+        } else {
+            rd.add(&name, mode, data)?;
+        }
+        added += 1;
+    }
+    Ok(added)
 }
 
